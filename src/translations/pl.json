  "editor.help.badge_entities": "Ile z wybranych encji jest aktywnych (np. grzeje, włączone, otwarte). Puste: ile termostatów z panelu grzeje",
  "editor.help.battery_entity": "Czujnik w % albo czujnik binarny baterii. Puste = informacja o bateriach z Better Thermostat na samym termostacie",
  "editor.help.cards": "Lista konfiguracji kart, jak w stosie pionowym",
  "editor.help.color_scheme": "Auto: jak w Home Assistant",
  "editor.help.days": "Ile dni kalendarza pokazać",
  "editor.help.device_class": "Zmienia ikony i kolory, np. „Drzwi” dla czujnika otwarcia na drzwiach. Puste = jak w HA",
  "editor.help.disarmed_color": "Domyślnie neutralny; np. czerwony jak w panelu Dom",
  "editor.help.edit_note": "Widoczny tylko podczas edycji dashboardu, np. „kopia na telefon”. Karty z warunkiem ekranu (swoim lub sekcji) dostają w edycji etykietę automatycznie",
  "editor.help.fab": "Karta znika z siatki i staje się okrągłym przyciskiem w prawym dolnym rogu ekranu",
  "editor.help.fab_narrow_only": "Włączone: pływający przycisk tylko na ekranach węższych niż 1024 px (telefon, tablet w pionie), na szerszych zwykła karta. Wyłączone: zawsze pływający przycisk",
  "editor.help.fab_sheet_cards": "Karty w panelu (lista YAML); karty klimatyzacji jako kompaktowe wiersze termostatów",
  "editor.help.fab_side": "Przy której krawędzi ekranu stoi pływający przycisk. Każda strona ma swój stos przycisków",
  "editor.help.fan_modes": "Nic nie zaznaczone = wszystkie prędkości urządzenia (więcej niż 5 jako lista rozwijana)",
  "editor.help.feedback": "Bez tego karta tylko uruchamia akcję",
  "editor.help.glow_color": "Domyślnie barwa światła",
  "editor.help.haptic_tick": "Typ wibracji co 1 % przy przeciąganiu suwaka. Jak mocno wibruje każdy typ, decyduje aplikacja HA i telefon. Puste = najlżejsze",
  "editor.help.haptics": "Delikatne wibracje przy dotknięciu, przytrzymaniu i przeciąganiu (aplikacja HA i przeglądarka na Androidzie)",
  "editor.help.hash": "Przejście do tego #hash otwiera pop-up (np. przycisk z akcją nawigacji do #nazwa)",
  "editor.help.heading_style": "Domyślnie nadtytuł (wersaliki)",
  "editor.help.height": "W pikselach; puste = domyślna (52, kompakt 36). Poniżej 48 px jeden wiersz: nazwa po lewej, wartość po prawej, wykres w tle",
  "editor.help.hvac_modes": "Nic nie zaznaczone = wszystkie tryby urządzenia (do 4 w jednym rzędzie, więcej w siatce po 3)",
  "editor.help.layout_screen": "Auto: wersja kompaktowa na ekranach węższych niż 1024 px",
  "editor.help.layout_width": "Auto: wersja kompaktowa, gdy karta jest wąska (np. 3 kolumny siatki)",
  "editor.help.max_width": "Karta nie będzie szersza niż ta wartość i zostanie wyśrodkowana w swoim miejscu. W procentach liczy się od szerokości miejsca w siatce. Puste = cała szerokość",
  "editor.help.narrow_only_fab": "Poniżej 1024 px przycisk w rogu, szerzej wiersz w siatce",
  "editor.help.nav_items": "Widoki dashboardu: ścieżka (rooms lub /lovelace/rooms), nazwa i ikona",
  "editor.help.nav_position": "Dół ekranu: przyklejony do krawędzi, sama karta zostawia odstęp (umieść ją na końcu); W siatce: zwykła karta",
  "editor.help.pm": "Wystarczy jeden z czujników: PM2.5, PM10 lub AQI",
  "editor.help.power_action": "Domyślnie włącza ostatni tryb lub wyłącza urządzenie",
  "editor.help.power_entity": "Przekaźnik albo gniazdko, które odcina prąd żarówce. Gdy jest wyłączony, żarówka pokazuje „Wyłączone” zamiast „Niedostępne”, a dotknięcie włącza przekaźnik. Puste = żarówka ma stałe zasilanie",
  "editor.help.power_entities": "Kilka przekaźników albo gniazdek zasilających to światło, zwykle grupę żarówek. Karta dostaje po jednym przycisku na przekaźnik i tylko one go przełączają: dotknięcie karty nic nie robi. Gdy działa choć jeden, karta ustawia jasność i barwę całego światła. Zastępuje pole wyżej",
  "editor.help.presence_badge": "Widoczny przy imieniu, gdy obecność pochodzi z czujnika obecności (domyślnie BLE; puste ukrywa)",
  "editor.help.presence_entity": "Np. czujnik BLE; bez niego liczy się strefa osoby",
  "editor.help.secondary_entity": "Jej stan jest drugą linią (np. stan odkurzacza)",
  "editor.help.show_trigger": "Wiersz w dashboardzie otwierający pop-up; wyłączony = karta niewidoczna",
  "editor.help.stale_after": "Puste lub 0 = nigdy. Brak nowego odczytu przez tyle godzin = przerywana ramka, „Nieaktualne · 3 h”. Wiele termometrów wysyła odczyt tylko przy zmianie temperatury",
  "editor.help.step": "O ile zmieniają nastawę przyciski − i +. Puste = krok z urządzenia",
  "editor.help.styles": "CSS wstawiany do karty, np. .press { border-radius: 8px }",
  "editor.help.sub_buttons": "Małe przyciski po prawej stronie karty, każdy z własną encją i akcją. Widać najwyżej 4, na wąskiej karcie 2, w kompakcie 1; reszta jest ukryta",
  "editor.help.temp_range": "Puste = zakres urządzenia",
  "editor.help.warnings_entity": "Sensor z listą ostrzeżeń w atrybucie warnings, np. IMGW-PIB Monitor",
  "editor.help.weather_effects": "Działa z kartą „Lumen · Tło pogodowe” w tym samym widoku",
  "editor.help.weather_hours": "4–8; karta pokazuje tyle kolumn, ile mieści się po min. 44 px",
